# Copy to secrets.yaml and fill in. secrets.yaml is gitignored — never commit it.
wifi_ssid: "YourWifiName"
wifi_password: "your-wifi-password"

# Fallback hotspot password (shown if the node can't join Wi-Fi)
ap_password: "choose-a-password"

# OTA update password
ota_password: "choose-a-password"

# Home Assistant API encryption key — generate with:
#   https://esphome.io/components/api.html#configuration-variables
ha_api_key: "generate-a-32-byte-base64-key"

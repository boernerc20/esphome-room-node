(footprint "room-node:AHT20"
	(layer "F.Cu")
	(descr "Aosong AHT20, temp/humidity sensor, LGA-4 3x2mm")
	(tags "temperature humidity sensor")
	(attr smd)
	(fp_text reference "REF**" (at 0 3.5) (layer F.SilkS)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text value "AHT20" (at 0 -4) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_line (start -1.5 1) (end 1.5 1) (layer F.Fab) (width 0.1))
	(fp_line (start 1.5 1) (end 1.5 -1) (layer F.Fab) (width 0.1))
	(fp_line (start 1.5 -1) (end -1.5 -1) (layer F.Fab) (width 0.1))
	(fp_line (start -1.5 -1) (end -1.5 1) (layer F.Fab) (width 0.1))
	(fp_circle (center -1.2 0.8) (end -0.8 0.8) (layer F.Fab) (width 0.2))
	(fp_line (start -2 1.5) (end 2 1.5) (layer F.CrtYd) (width 0.05))
	(fp_line (start 2 1.5) (end 2 -1.5) (layer F.CrtYd) (width 0.05))
	(fp_line (start 2 -1.5) (end -2 -1.5) (layer F.CrtYd) (width 0.05))
	(fp_line (start -2 -1.5) (end -2 1.5) (layer F.CrtYd) (width 0.05))
	(pad "1" smd roundrect (at -0.85 0.85) (size 0.65 0.55) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
	(pad "2" smd roundrect (at -0.85 -0.85) (size 0.65 0.55) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
	(pad "3" smd roundrect (at 0.85 0.85) (size 0.65 0.55) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
	(pad "4" smd roundrect (at 0.85 -0.85) (size 0.65 0.55) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
)
	(text "SELECT (pin 2) to GND = left channel.\nR9/R10 (33 Ω) at U1, R11 at MK1: optional damping; use 0 Ω if removed.\nR8 100k on I2S_MIC_DATA to GND.  C11 100 pF C0G is DNP (do not fit).\nUse the stock symbol/footprint (Sensor_Audio). Footprint has the sound hole;\nGND ring around it. Mic mute is software only (no mute switch)."
		(exclude_from_sim no)
		(at 25.4 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "80611dc7-6d29-52a4-bf58-a533afaedc06")
	)
